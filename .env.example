# GROQ_API_KEY: Required for GroqCloud AI Tutor & Personalized Feedback (server-side only).
# Configure this in your platform Secrets panel. Never hardcode or expose to the browser.
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# GROQ_MODEL: Optional override for the Groq chat model (default: openai/gpt-oss-20b).
GROQ_MODEL="openai/gpt-oss-20b"

# CANVA_VIEW_URL: Optional public Canva view/present link for learners (never use an /edit link).
CANVA_VIEW_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
